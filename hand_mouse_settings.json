{
  "_help": [
    "Hand Mouse settings. Save this file and restart Hand Mouse after editing.",
    "An action can use: label (text shown), keys (pressed together),",
    "type (text to type), open (program, folder or website),",
    "repeat (true = repeats while held), do (clear_ink, toggle_presentation,",
    "toggle_enabled). Set a gesture to null to turn it off.",
    "Gesture names: THUMBS_UP, THUMBS_DOWN, ROCK, SHAKA, THREE,",
    "BOTH_L, BOTH_POINT, BOTH_PEACE, SWIPE_LEFT, SWIPE_RIGHT.",
    "Profiles are checked top to bottom; the first match wins. A profile",
    "matches by program (e.g. powerpnt.exe) and/or title_contains.",
    "Delete this file to get the default settings back."
  ],
  "mouse_hand": "right",
  "far_mode": false,
  "far_zoom": 2.5,
  "laser_gain": 0.18,
  "laser_color": "#ff2020",
  "pen_color": "#ffd000",
  "show_toasts": true,
  "global": {
    "THUMBS_UP": {
      "label": "Volume up",
      "keys": [
        "volumeup"
      ],
      "repeat": true
    },
    "THUMBS_DOWN": {
      "label": "Volume down",
      "keys": [
        "volumedown"
      ],
      "repeat": true
    },
    "ROCK": {
      "label": "Mute",
      "keys": [
        "volumemute"
      ]
    },
    "SHAKA": {
      "label": "Start menu",
      "keys": [
        "win"
      ]
    },
    "THREE": {
      "label": "Play/Pause",
      "keys": [
        "playpause"
      ]
    },
    "BOTH_L": {
      "label": "Screenshot",
      "keys": [
        "win",
        "shift",
        "s"
      ]
    },
    "BOTH_POINT": {
      "label": "Task view",
      "keys": [
        "win",
        "tab"
      ]
    },
    "BOTH_PEACE": {
      "label": "Show desktop",
      "keys": [
        "win",
        "d"
      ]
    },
    "SWIPE_LEFT": {
      "label": "Next tab",
      "keys": [
        "ctrl",
        "tab"
      ]
    },
    "SWIPE_RIGHT": {
      "label": "Previous tab",
      "keys": [
        "ctrl",
        "shift",
        "tab"
      ]
    }
  },
  "presentation": {
    "SWIPE_LEFT": {
      "label": "Next slide",
      "keys": [
        "right"
      ],
      "do": "clear_ink"
    },
    "SWIPE_RIGHT": {
      "label": "Previous slide",
      "keys": [
        "left"
      ],
      "do": "clear_ink"
    },
    "THUMBS_UP": {
      "label": "Next slide",
      "keys": [
        "right"
      ],
      "do": "clear_ink"
    },
    "THUMBS_DOWN": {
      "label": "Previous slide",
      "keys": [
        "left"
      ],
      "do": "clear_ink"
    },
    "THREE": {
      "label": "Black screen",
      "keys": [
        "b"
      ]
    },
    "ROCK": {
      "label": "Clear drawings",
      "do": "clear_ink"
    },
    "BOTH_PEACE": {
      "label": "End slide show",
      "keys": [
        "esc"
      ]
    }
  },
  "profiles": [
